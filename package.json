{
  "name": "@jdlanyon/lotus-library",
  "version": "0.2.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "description": "Reusable Panel, Button and Glitch components for reproducible custom websites (React + Vue 3).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Jackson Lanyon <jlany9@hotmail.com>",
  "type": "module",
  "main": "./dist/react/index.cjs",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/next": {
      "import": {
        "types": "./dist/react/next.d.ts",
        "default": "./dist/react/next.js"
      },
      "require": {
        "types": "./dist/react/next.d.cts",
        "default": "./dist/react/next.cjs"
      }
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./style.css": "./dist/lotus.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "next build",
    "build-storybook": "storybook build",
    "build:lib": "tsup && node scripts/fold-vue-css.mjs && npm run build:types:vue",
    "build:types:vue": "vue-tsc -p tsconfig.vue.json",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.vue.json --noEmit"
  },
  "peerDependencies": {
    "@icons-pack/react-simple-icons": ">=10",
    "lucide-react": ">=0.400 <2",
    "lucide-vue-next": ">=0.400 <2",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3",
    "vue-simple-icons": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "@icons-pack/react-simple-icons": {
      "optional": true
    },
    "lucide-vue-next": {
      "optional": true
    },
    "vue-simple-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild-plugin-vue-next": "^0.1.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-storybook": "^10.6.1",
    "lucide-react": "^0.475.0",
    "lucide-vue-next": "^0.475.0",
    "next": "16.2.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vue": "^3.5.38",
    "vue-simple-icons": "^7.5.0",
    "vue-tsc": "^3.3.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDLanyon/lotus-library.git"
  }
}
